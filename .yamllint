---
extends: default
rules:
  line-length:
    max: 160
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ['true', 'false']
    # Allow GitHub Actions' `on:` key without a truthy warning.
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
ignore: |
  molecule/*/roles/
  .ansible/
